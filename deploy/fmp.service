# /etc/systemd/system/fmp.service  ·  API en /opt/fmp, escuchando solo en localhost (Apache hace de proxy)
[Unit]
Description=fmp - API de la liga FMP (MV Padel Cercedilla)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/fmp
EnvironmentFile=/opt/fmp/.env
ExecStart=/opt/fmp/.venv/bin/python -m uvicorn fmp.api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
