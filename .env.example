# Credenciales de https://www.fmpadel.com (opcional: los datos públicos no las necesitan)
FMP_USER=
FMP_PASS=
# Nombre (o parte) del equipo a seguir. Se busca sin distinguir mayúsculas ni espacios.
FMP_TEAM=CERCEDILLA A
# idEquipo que casan con el nombre pero no son nuestro equipo (5154 = 'MVPADEL CERCEDILLA' 2023/24, anterior al A y al B)
FMP_EXCLUIR_EQUIPOS=5154
# Ruta de la base de datos SQLite
FMP_DB=data/fmp.db
# Clave para firmar los tokens de sesión (se genera sola si está vacía y se guarda en .env)
FMP_SECRET=
# Horas de validez de la sesión
FMP_TOKEN_HOURS=72
# Orígenes permitidos para CORS en desarrollo (ng serve). En producción déjalo vacío.
FMP_CORS=http://localhost:4200
# Carpeta con la web Angular compilada (por defecto ../fmp/dist/frontend/browser)
FMP_DIST=
